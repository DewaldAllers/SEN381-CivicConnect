# Copy to .env.staging (git ignores it) and fill in the value. Never commit .env.staging.
# Names only here: no real values belong in the repository.
NODE_ENV=staging
PORT=4000
# Shared password for the seeded demo users. Required: the server refuses to start without it.
SEED_USER_PASSWORD=
# Load the three sample requests on start. Set to false for a clean environment.
SEED_DEMO_DATA=true
# Restricted runtime connection. Never use the database owner for the running app.
DATABASE_URL=
# Owner/migration connection. Passed only to migrations, not the app process.
DATABASE_ADMIN_URL=
